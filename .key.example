# =============================================================================
# GBclaw API configuration
# Copy this file to .key and fill in your credentials.
#
# Secrets and model choices belong here. Runtime resource knobs such as MPI ranks
# and render timeouts belong in .env.
# =============================================================================

[settings]
# false: use [default] for every LLM call.
# true: route calls through [premium], [medium], and [light].
use_tier_routing = false

[model_routing]
# Used only when [settings] use_tier_routing = true.
orchestrator = premium
planning = premium
literature = premium
structure = medium
lammps = medium
analysis = medium
coding = medium
memory = medium
default = medium


# =============================================================================
# Single-model mode
# Used when [settings] use_tier_routing = false.
# =============================================================================

[default]
provider = openai
# OpenAI official: prefer responses for reasoning, tools, and reasoning-summary
# streaming. Private OpenAI-compatible gateways that expose only
# /chat/completions should use chat_completions instead.
api_mode = responses
api_key = sk-your-api-key-here
base_url = https://api.openai.com/v1
model = gpt-5.5
temperature = 0.2
timeout = 120

# Optional common model fields: defining token limits overrides the defaults.
# Leave them undefined unless you know why an explicit override is needed.
# max_tokens limits thinking + final answer together.
# It does not limit tool reports/history; those use compact results and paged reads.
# GBCLAW_CONTEXT_1M scales context allocations, not this generation ceiling.
# Omitted max_tokens defaults to 8192 with thinking disabled and 32768 with
# thinking enabled. With thinking enabled, omit it or set >= 16384.
# Do NOT pair thinking=enabled with a small budget like 8192 — reasoning can
# exhaust the budget and leave an empty final answer.
# max_tokens = 32768
# Undefined max_input_tokens automatically follows GBCLAW_CONTEXT_1M:
# 262144 (256K) by default, 1048576 (1M) when enabled.
# An explicit model capacity is fixed and does NOT scale with the switch.
# max_input_tokens = 262144
# thinking = disabled
# Portable values: low, medium, high, xhigh, max. GBclaw maps unavailable model
# levels to the nearest supported one. Prefer low or medium for normal tasks.
# reasoning_effort = low

# Provider variants use the same token/thinking keys above:
#
# DeepSeek native:
# provider = deepseek
# api_mode = chat_completions
# base_url = https://api.deepseek.com
# model = deepseek-v4-pro
#
# Anthropic/Claude Messages API ("claude" is accepted as a provider alias):
# provider = anthropic
# api_mode = chat_completions
# base_url = https://api.anthropic.com
# model = claude-sonnet-4-6
#
# For Claude 4.5 and earlier, GBclaw derives legacy budget_tokens from
# max_tokens + reasoning_effort. Claude 4.6+ uses adaptive thinking automatically.


# =============================================================================
# Tiered model mode
# Used when [settings] use_tier_routing = true.
# =============================================================================

[premium]
provider = openai
api_mode = responses
api_key = sk-your-api-key-here
base_url = https://api.openai.com/v1
model = gpt-5.5
temperature = 0.2
timeout = 300
# max_tokens = 32768
# max_input_tokens = 262144
# thinking = disabled
# reasoning_effort = high

[medium]
provider = openai
api_mode = responses
api_key = sk-your-api-key-here
base_url = https://api.openai.com/v1
model = gpt-5.5
temperature = 0.2
timeout = 180
# max_tokens = 32768
# max_input_tokens = 262144
# thinking = disabled
# reasoning_effort = high

[light]
provider = openai
api_mode = chat_completions
api_key = sk-your-api-key-here
base_url = https://api.openai.com/v1
model = gpt-5.5-mini
temperature = 0.2
timeout = 90
# max_tokens = 8192
# max_input_tokens = 262144
# thinking = disabled


# =============================================================================
# Short-term runtime context
# =============================================================================

[runtime_context]
enabled = true
# Defining the optional token budgets below overrides built-in defaults.
# Leave them undefined unless you know what you are doing.
# Undefined defaults automatically scale from 256K to 1M with GBCLAW_CONTEXT_1M.
# Base 256K profile; GBCLAW_CONTEXT_1M=1 multiplies all token budgets below by 4.
# K = 1024 tokens. Explicit model max_input_tokens remains a capacity limit.
# total_context_tokens = 262144
# Recent uncompressed conversation and ordinary tool results only.
# active_context_tokens = 65536
# Durable project summary and compressed conversation have separate caps.
# project_summary_max_tokens = 32768
# summary_model_max_tokens = 32768
# Live plan state and retrieved memory share this budget.
# memory_context_tokens = 65536
# Delegated workers compact their single-pool history at this share of it (0.3-0.95).
# worker_compact_fraction = 0.8
# Reserve includes model output; a larger output limit reserves more.
# safety_margin_tokens = 32768
# Separate memory-model request input: prior project summary + semantic changes.
# project_summary_working_set_max_tokens = 65536

# =============================================================================
# Optional web search
# Leave enabled = false to omit the search_web tool entirely.
#
# If enabled = true, set model to an OpenAI Responses API web-search-capable
# model. api_key, model and base_url may be left blank only when the endpoint
# routed to the `literature` role ([default] in single-model mode) uses
# provider = openai with an official OpenAI or Azure OpenAI base_url; that
# endpoint is then reused. Deleting this section entirely also enables search
# automatically for such an endpoint.
# =============================================================================

[web_search]
enabled = false
api_key =
base_url =
model =
timeout = 60


# =============================================================================
# LangSmith tracing
# =============================================================================

[langsmith]
enabled = false
api_key =
project = GBclaw
endpoint = https://api.smith.langchain.com
