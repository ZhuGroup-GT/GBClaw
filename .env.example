# =============================================================================
# GBclaw Runtime Environment
# =============================================================================
# Copy or mirror these lines into .env. GBclaw loads .env automatically at
# startup. Commonly tuned settings are shown commented out at their code
# defaults; uncomment and edit a line to override one. docs/configuration.md
# describes every setting.
#
# Existing shell environment variables win over values in .env.
# LLM/API keys are still configured in .key, not here.
# =============================================================================

# Set to 1 to serialize Structure/LAMMPS work, or 0 to allow independent work
# to run concurrently within the Structure worker and LAMMPS MPI-rank budgets.
# GBCLAW_SERIAL_EXECUTION=1

# Conda environment used for managed LAMMPS MPI runs. It must provide the LAMMPS
# Python bindings, mpi4py, and the pair styles required by the selected potentials.
# GBCLAW_LAMMPS_CONDA_ENV=GBclaw-lammps

# Optional coding runtime for Atomic Simulation Environment (ASE).
# Registering it does not install Conda or ASE; missing environments are listed as unavailable.
# GBCLAW_ASE_CONDA_ENV=GBclaw-ase

# Directory containing potentials.json and the potential files registered in it.
# Relative paths are resolved from the GBclaw repository root.
# GBCLAW_POTENTIALS_DIR=data/potentials

# MPI ranks used by one LAMMPS agent when a managed runner's np is omitted.
# The fixed default is 18; it is not detected from the host CPU count.
# Set this and the total budget to fit the physical cores available to the application.
# GBCLAW_LAMMPS_AGENT_MPI_RANKS=18

# Total MPI rank budget reserved for LAMMPS workflows.
# In parallel mode, default-size concurrency = floor(total / per-agent).
# Every minimization, GB-energy, shear, and NEB launch reserves its actual MPI ranks, so
# mixed-size runs cannot exceed this budget. An NEB topology must fit by itself.
# GBCLAW_LAMMPS_TOTAL_MPI_RANKS=18

# Partition topology for one GB NEB run. The product is the exact mpirun size
# and may not exceed GBCLAW_LAMMPS_TOTAL_MPI_RANKS.
# GBCLAW_LAMMPS_NEB_REPLICAS=16
# GBCLAW_LAMMPS_NEB_RANKS_PER_REPLICA=1

# Wall-clock timeouts in seconds for managed LAMMPS runs.
# GBCLAW_GB_MINIMIZE_TIMEOUT_SEC=3600
# GBCLAW_STRUCTURE_MINIMIZE_TIMEOUT_SEC=3600
# GBCLAW_GB_ENERGY_TIMEOUT_SEC=14400
# GBCLAW_GB_SHEAR_TIMEOUT_SEC=7200
# GBCLAW_GB_NEB_TIMEOUT_SEC=14400

# Timeout in seconds for one OVITO rendering subprocess.
# GBCLAW_RENDER_TIMEOUT_SEC=600

# Timeout in seconds for one GB periodicity-analysis subprocess.
# GBCLAW_PERIODICITY_TIMEOUT_SEC=1200

# Disposable coding-worker sandbox. Bubblewrap is required. Networking is blocked with an
# audited seccomp filter; project inputs are staged read-only and only validated outputs persist.
# GBCLAW_BWRAP_PATH=/usr/bin/bwrap
# GBCLAW_CODING_ENVIRONMENTS_FILE=src/domains/coding/environments.toml
# GBCLAW_CODING_COMMAND_TIMEOUT_SEC=300
# GBCLAW_CODING_TASK_TIMEOUT_SEC=1800
# GBCLAW_CODING_MAX_OUTPUT_BYTES=100000
# GBCLAW_CODING_MAX_WORKSPACE_MB=128
# GBCLAW_CODING_MAX_INPUT_FILES=20
# GBCLAW_CODING_MAX_INPUT_MB=256
# GBCLAW_CODING_MAX_PUBLISHED_FILES=20
# GBCLAW_CODING_MAX_PUBLISHED_MB=32
# Per-task default and process-wide weighted compute-slot budget. Independent
# coding delegations run concurrently while their summed reservations fit.
# For a local MPI task, delegate_coding mpi_ranks consumes the same slots.
# GBCLAW_CODING_AGENT_COMPUTE_SLOTS=4
# GBCLAW_CODING_TOTAL_COMPUTE_SLOTS=36
# GBCLAW_CODING_MEMORY_MB=4096
# GBCLAW_CODING_CPU_SECONDS=600
# GBCLAW_CODING_MAX_PROCESSES=96
# GBCLAW_CODING_MAX_OPEN_FILES=256
# Process-tree enforcement: auto (cgroup when delegated, else monitor), cgroup, or monitor.
# GBCLAW_CODING_RESOURCE_MODE=auto
# GBCLAW_CODING_CGROUP_ROOT=
# GBCLAW_CODING_RECURSION_LIMIT=200

# Total process limit for the shared Structure/CSL pool (default: 18).
# Capped by the physical cores available to the service. On Linux, each process
# binds to a distinct physical core, with native math libraries using one thread.
# A task can use multiple pool processes; concurrent tasks share the same limit.
# GBCLAW_WORKERS=18

# Maximum tool input/output preview lengths sent to interactive clients.
# Complete tool I/O is still retained in the permanent chat transcript.
# GBCLAW_MAX_TOOL_INPUT=280
# GBCLAW_MAX_TOOL_OUTPUT=400
# Delegate tools show the worker task/result summary rather than truncated raw JSON.
# GBCLAW_MAX_DELEGATE_INPUT=1200
# GBCLAW_MAX_DELEGATE_OUTPUT=8000

# Number of recent tool results kept when orchestrator context editing clears
# older tool outputs. Default is 4 when unset.
# GBCLAW_TOOL_KEEP_RESULTS=4

# Disable ANSI colors in the terminal CLI when set to any value.
# NO_COLOR=1

# Context profile: 0 = 256K; 1 = 1M (all runtime token budgets scale by 4).
# K = 1024 tokens. Explicit model max_input_tokens still limits actual capacity.
# Leave optional .key token budgets undefined to use the automatically scaled defaults.
# GBCLAW_CONTEXT_1M=0

# Project workspace directory (default: <repo>/projects). Use an absolute path.
# GBCLAW_PROJECTS_ROOT=

# Comma-separated trusted extension modules to load at startup.
# GBCLAW_EXTENSIONS=
